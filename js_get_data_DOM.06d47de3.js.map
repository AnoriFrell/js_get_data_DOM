var sum = 0;
var getPopulation = document.querySelectorAll('.population');
var total = document.querySelector('.total-population');
var average = document.querySelector('.average-population');
getPopulation.forEach(function(item) {
    var population = item.textContent;
    sum += Number(population.replaceAll(',', ''));
});
var averagePopulation = sum / getPopulation.length;
total.textContent = sum.toLocaleString('en-US');
average.textContent = averagePopulation.toLocaleString('en-US');

